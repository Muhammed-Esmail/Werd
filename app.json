{
  "expo": {
    "name": "Werd",
    "assetBundlePatterns": [
      "**/*",
      "assets/database/*.db"
    ],
    "slug": "Werd",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/47f55b15-f240-44fd-a5f6-2035ad20d3ee"
    },
    "orientation": "portrait",
    "icon": "./assets/images/Werdd.png",
    "userInterfaceStyle": "light",
    "scheme": "werd",
    "newArchEnabled": true,
    "jsEngine": "hermes",
    "ios": {
      "supportsTablet": true,
      "jsEngine": "hermes"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/Werdd.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.Werd",
      "jsEngine": "hermes"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/Werdd.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/Werdd.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-sqlite",
      "expo-localization",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "hermes": {
        "intl": true
      },
      "eas": {
        "projectId": "47f55b15-f240-44fd-a5f6-2035ad20d3ee"
      }
    },
    "owner": "werd-team"
  }
}
